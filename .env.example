# Copy this file to .env and fill in your API keys
XAI_API_KEY=your_xai_api_key_here
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_OMDB_API_KEY=your_omdb_api_key_here

# Shared test account. Everyone (humans and agents) signs in with this one; never sign up new ones.
# Cloud agents get these from Cursor Dashboard > Cloud Agents > Secrets. Seed with `npm run seed:test-account`.
SELECTS_TEST_EMAIL=
SELECTS_TEST_PASSWORD=
