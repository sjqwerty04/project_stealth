# Copy this file to .env and fill in your keys.
#
# VITE_ is not a namespace — Vite inlines every VITE_ variable into the client
# bundle as plain text. Anything under that prefix is public. Keys that cost
# money must be set without it so they stay on the server.

# --- Server only (set in Vercel project settings, never with a VITE_ prefix) ---
# Anthropic key used by /api/claude and /api/movie-chat.
CLAUDE_API_KEY=your_claude_api_key_here
# OpenRouter key used by /api/movie-known-for.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Firebase project whose ID tokens the API will accept. Defaults to mvplockedin.
FIREBASE_PROJECT_ID=mvplockedin
# Optional: extra comma-separated origins allowed to call /api (beyond production,
# localhost and *.vercel.app previews).
ALLOWED_ORIGINS=

# --- Client (public by design; these end up in the bundle) ---
# TMDB is read-only and rate limited per key, so exposure is tolerable.
VITE_TMDB_API_KEY=your_tmdb_api_key_here
# OMDb's free tier is non-commercial only. Confirm the licence before launch.
VITE_OMDB_API_KEY=your_omdb_api_key_here

# --- Deprecated ---
# Still read as a fallback so existing deployments keep working. Remove it once
# CLAUDE_API_KEY is set, and rotate the key: the VITE_ prefix means it may
# already have been served to browsers.
# VITE_CLAUDE_API_KEY=
