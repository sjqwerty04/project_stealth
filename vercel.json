{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/movie-chat.ts": {
      "includeFiles": "src/skills/**"
    },
    "api/movie-known-for.ts": {
      "includeFiles": "src/skills/**"
    },
    "api/your-selects.ts": {
      "includeFiles": "src/skills/**"
    },
    "api/selects-profile.ts": {
      "includeFiles": "src/skills/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
