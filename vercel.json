{
  "rewrites": [
    {
      "source": "/api/movie-images",
      "destination": "/api/movie-media?kind=images"
    },
    {
      "source": "/api/movie-clip",
      "destination": "/api/movie-media?kind=clip"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/movie-chat.ts": {
      "includeFiles": "src/skills/**"
    },
    "api/movie-known-for.ts": {
      "includeFiles": "src/skills/**"
    },
    "api/your-selects.ts": {
      "includeFiles": "src/skills/**"
    },
    "api/selects-profile.ts": {
      "includeFiles": "src/skills/**"
    },
    "api/voice/[route].ts": {
      "includeFiles": "{voice/**,src/skills/**}",
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
