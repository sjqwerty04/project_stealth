default_platform(:ios)

platform :ios do
  desc "Archive Selects and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: false
    )

    begin
      produce(
        api_key: api_key,
        app_identifier: "com.moviecally.app",
        app_name: "Selects",
        language: "English",
        sku: "selects-ios",
        team_id: "L37YSKFC5X"
      )
    rescue StandardError => e
      UI.important("App record may already exist: #{e.message}")
    end

    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      xcodeproj: "App/App.xcodeproj",
      build_number: build_number
    )

    if ENV["MATCH_KEYCHAIN_NAME"]
      get_certificates(
        api_key: api_key,
        keychain_path: ENV["MATCH_KEYCHAIN_NAME"],
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"].to_s
      )
    else
      get_certificates(api_key: api_key)
    end

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.moviecally.app",
      force: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App/App.xcodeproj",
      team_id: "L37YSKFC5X",
      bundle_identifier: "com.moviecally.app",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      workspace: "App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.moviecally.app" => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
